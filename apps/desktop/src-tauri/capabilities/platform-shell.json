{
  "identifier": "platform-shell",
  "description": "The local shell can load the platform fixture and report a requested smoke test.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-platform-scene",
    "allow-complete-platform-smoke",
    "allow-northbridge-history",
    "allow-workspace-worlds",
    "allow-workspace-create-world",
    "allow-workspace-snapshot",
    "allow-workspace-search",
    "allow-workspace-next-search-page",
    "allow-workspace-cancel-query",
    "allow-workspace-discover-mentions",
    "allow-workspace-review-mention",
    "allow-workspace-save-person-alias",
    "allow-workspace-saved-queries",
    "allow-workspace-save-query",
    "allow-workspace-replay-saved-query",
    "allow-workspace-query-path",
    "allow-workspace-query-participant-events",
    "allow-workspace-composite-query",
    "allow-workspace-entry-layout",
    "allow-workspace-save-layout",
    "allow-workspace-public-entry",
    "allow-workspace-create-person",
    "allow-workspace-create-relationship",
    "allow-workspace-record-relationship-state",
    "allow-workspace-save-definition",
    "allow-workspace-evidence",
    "allow-workspace-record-evidence",
    "allow-workspace-record-event"
  ]
}
